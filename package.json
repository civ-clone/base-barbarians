{
  "name": "@civ-clone/base-barbarians",
  "version": "0.1.0",
  "description": "Barbarian mechanics for a rule set to use: the gate on when barbarians may appear, the barbarian player, spawning a group (aboard a ship or not), ransom, a city's worth to raiders, and what the barbarians' client asks a rule set.",
  "repository": "git@github.com:civ-clone/base-barbarians.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "Rules/**/*.ts",
    "Rules/**/*.js",
    "Rules/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-client": "^0.1.0",
    "@civ-clone/core-world-generator": "^0.1.7",
    "@civ-clone/core-terrain": "^0.1.4",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-city-yield-gold": "^0.1.1",
    "@civ-clone/base-civilization-barbarian": "^0.1.1",
    "@civ-clone/base-player": "^0.1.2",
    "@civ-clone/base-unit-action-embark": "^0.1.6",
    "@civ-clone/base-unit-type-naval-transport": "^0.1.3",
    "@civ-clone/core-city": "^0.1.25",
    "@civ-clone/core-city-growth": "^0.1.6",
    "@civ-clone/core-game": "^0.1.17",
    "@civ-clone/core-government": "^0.1.6",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-treasury": "^0.1.10",
    "@civ-clone/core-turn-based-game": "^0.1.10",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-world": "^0.1.24"
  }
}
